# Relative paths resolve from the repository, not the shell working directory.
SAFESENSE_DATABASE=data/safesense.db
SAFESENSE_MODEL_PATH=models/yolo26n.pt
SAFESENSE_CONFIDENCE=0.45
SAFESENSE_IMAGE_SIZE=640
SAFESENSE_DEVICE=cpu
SAFESENSE_CAPTURE_FPS=12
SAFESENSE_INFERENCE_FPS=3
SAFESENSE_MIN_OBSERVATIONS=3
SAFESENSE_COOLDOWN_SECONDS=30
# JSON map of actual model labels to canonical person/helmet/vest/gloves/boots.
SAFESENSE_CLASS_MAP={}
# Optional credentials: add a camera with source env:MY_CAMERA_URL.
# MY_CAMERA_URL=rtsp://user:password@camera-address/stream

# Specialized optional detectors; model status reports their actual classes.
SAFESENSE_PPE_MODEL_PATH=models/ppe-yolo11n.pt
SAFESENSE_FIRE_MODEL_PATH=models/fire-yolov8s.pt
SAFESENSE_ADMIN_NAME=admin
SAFESENSE_ADMIN_PASSWORD=admin
SAFESENSE_SESSION_HOURS=8
